# =================================================================
# Adaptive AI Learning Platform - Environment Configuration
# =================================================================

# Application Settings
APP_NAME="Adaptive AI Learning Platform"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=supersecret-change-this-in-production-jwt-key-32bytes-min!

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=learning_user
POSTGRES_PASSWORD=learning_secure_password
POSTGRES_DB=adaptive_learning_db
DATABASE_URL=postgresql+asyncpg://learning_user:learning_secure_password@localhost:5432/adaptive_learning_db

# Redis Cache & Task Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector Database (Qdrant) Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=study_materials

# LLM Inference (Ollama Development Backend)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=qwen2.5:3b-instruct
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Storage Configuration
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=50

# Security & CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
